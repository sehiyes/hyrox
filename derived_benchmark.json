{
  "model_version": "UNIFIED-PERFORMANCE-V4.1",
  "benchmark_source": {
    "file": "derived benchmark(4).json",
    "immutable": true,
    "mixed_doubles_benchmark_gender": "MIXED",
    "mixed_doubles_conversion_gender": "athlete_gender",
    "fallback_chain": [
      "ASIA",
      "ASIA_AGE_RELAXED",
      "GLOBAL_HISTORICAL",
      "GLOBAL_HISTORICAL_AGE_RELAXED",
      "GLOBAL_MATRIX",
      "STATIC_FALLBACK"
    ],
    "min_sample_medium": 30,
    "min_sample_high": 100
  },
  "target_model": {
    "base_division_is_calculation_anchor": false,
    "goal_division_is_target": true,
    "run_aggregation": "run_1..run_8",
    "stations_independent": true
  },
  "recency_weights": [
    {
      "max_months": 6,
      "weight": 1.0
    },
    {
      "max_months": 12,
      "weight": 0.75
    },
    {
      "max_months": 18,
      "weight": 0.55
    },
    {
      "max_months": 24,
      "weight": 0.35
    },
    {
      "max_months": null,
      "weight": 0.15
    }
  ],
  "doubles_contribution": {
    "enabled": true,
    "run_total_factor": 1.0,
    "user_input_first": true,
    "empirical_prior_fallback": true,
    "gender_aware": true,
    "division_aware": true,
    "segment_aware": true
  },
  "conversion_matrix": {
    "must_be_real_race_derived": true,
    "hardcoded_final_values": false,
    "dimensions": [
      "athlete_gender",
      "source_division",
      "target_division",
      "segment",
      "sample_n",
      "median_ratio",
      "p25_ratio",
      "p75_ratio",
      "confidence"
    ]
  }
}
